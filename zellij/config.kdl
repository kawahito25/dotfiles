keybinds clear-defaults=false {
    normal {
        unbind "Ctrl p" // default: SwitchToMode Pane
        unbind "Ctrl o" // default: SwitchToMode Session
        unbind "Ctrl q" // default: Quit
        unbind "Ctrl b"
        bind "Ctrl a" { SwitchToMode "Pane"; }
        bind "Alt w" { SwitchToMode "Session"; }
        bind "Alt q" { Quit; }
    }
    pane {
        unbind "c"
        bind "," { SwitchToMode "RenamePane"; }

        unbind "f"
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
    }

    tab {
        unbind "r"
        bind "," { SwitchToMode "RenameTab"; }

        unbind "n"
        bind "c" { NewTab; }
    }

    locked {
        unbind "Ctrl g"
        bind "Alt g" { SwitchToMode "Normal"; }
    }

    shared_except "locked" {
        unbind "Ctrl n"
        unbind "Ctrl g"

        bind "Ctrl m" { SwitchToMode "Move"; }
        bind "Ctrl s" { SwitchToMode "Resize";  }
        bind "Ctrl ¥" { NewPane "Right"; }
        bind "Ctrl -" { NewPane "Down"; }
        bind "Alt g" { SwitchToMode "Locked"; }

        unbind "Alt +"
        unbind "Alt -"
        bind "Alt p" { Resize "Increase"; }
        bind "Alt n" { Resize "Decrease"; }

        bind "Ctrl h" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus_or_tab";
                payload "left";

                // Plugin Configuration
                move_mod "ctrl"; // Optional, should be added on every move command if changed.
                use_arrow_keys "false"; // Optional, uses arrow keys instead of hjkl. Should be added to every command where you want to use it.
            };
        }
        bind "Ctrl j" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "down";

                move_mod "ctrl";
                use_arrow_keys "false";
            };
        }
        bind "Ctrl k" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "up";

                move_mod "ctrl";
                use_arrow_keys "false";
            };
        }
        bind "Ctrl l" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus_or_tab";
                payload "right";

                move_mod "ctrl"; // Optional, should be added on every command if you want to use it
                use_arrow_keys "false";
            };
        }
        bind "Alt h" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "resize";
                payload "left";

                resize_mod "alt";
            };
        }
        bind "Alt j" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "resize";
                payload "down";

                resize_mod "alt";
            };
        }
        bind "Alt k" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "resize";
                payload "up";

                resize_mod "alt";
            };
        }
        bind "Alt l" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "resize";
                payload "right";

                resize_mod "alt";
            };
        }
    }
}

show_startup_tips false
theme "catppuccin-mocha"
