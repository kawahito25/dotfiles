#!/bin/bash

git log --oneline --format='%h %s (%cr) <%an>' "$@" | fzf \
    --height 100% \
    --layout=reverse \
    --header "Ctrl-o: Open in Browser | Ctrl-y: Copy Hash" \
    --preview 'git show --color=always {1} | delta --width=$FZF_PREVIEW_COLUMNS --paging=never' \
    --preview-window 'up:75%,wrap' \
    --bind "ctrl-o:execute-silent(gh browse {1} > /dev/null 2>&1 &)" \
    --bind "ctrl-y:execute-silent(echo -n {1} | pbcopy)"
