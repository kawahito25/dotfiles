#!/bin/bash
# Description: Interactive git branch creator with prefix option or fzf
# Usage: git cob [-p prefix]

set -e

base_name=""

# 1. Parse Options (-p prefix)
while getopts "p:" opt; do
    case "$opt" in
        p) base_name="${OPTARG}_" ;; # 引数の末尾に自動で "_" を付与
        *) echo "Usage: git cob [-p prefix]" && exit 1 ;;
    esac
done

# 2. Base branch selection via fzf (Only if -p is NOT specified)
if [ -z "$base_name" ]; then
    fmt='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) | %(color:green)%(committerdate:relative)%(color:reset) | %(color:blue)%(authordate:short)%(color:reset)'

    selected=$( (git branch --sort=-committerdate --format="$fmt" --color=always | column -ts '|' | \
        fzf --ansi --no-multi --height 40% --query="kawahito/" --tiebreak=index \
            --header 'Select a base branch name to copy/edit (Or just press Enter to start fresh)' \
            --bind 'start:deselect' \
            || true) | awk '{print ($1=="*" ? $2 : $1)}')

    base_name="${selected:-kawahito/}"
fi

# 3. Pure Bash Interactive Prompt
printf "Create new branch: %s" "$base_name"
new_branch="$base_name"

while IFS= read -r -s -n1 c; do
    if [ -z "$c" ]; then       # Enter
        printf "\n"
        break
    elif [[ "$c" == $'\x7f' || "$c" == $'\x08' ]]; then # Backspace
        if [ ${#new_branch} -gt 0 ]; then
            new_branch="${new_branch%?}"
            printf "\b \b"
        fi
    elif [[ "$c" == $'\x03' ]]; then # Ctrl+C
        printf "\n"
        new_branch=""
        break
    else                        # Input character
        new_branch+="$c"
        printf "%s" "$c"
    fi
done

# 4. Validation & Checkout
if [ -z "$new_branch" ] || [ "$new_branch" = "kawahito/" ] || [[ "$new_branch" == *"_" ]]; then
    echo "Aborted. (Invalid or incomplete branch name)"
    exit 0
fi

git checkout -b "$new_branch"
