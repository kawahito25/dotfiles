#!/bin/bash
# Description: Interactive git branch creator with prefix option or fzf
# Usage: git cob [-p prefix]

set -e

base_name=""
default_prefix="kawahito/"

# 1. Parse Options (-p prefix)
while getopts "p:" opt; do
    case "$opt" in
        p) base_name="${OPTARG}_" ;; # 引数の末尾に自動で "_" を付与
        *) echo "Usage: git cob [-p prefix]" && exit 1 ;;
    esac
done

# 2. Base branch selection via fzf (Only if -p is NOT specified)
if [ -z "$base_name" ]; then
    fmt='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) | %(color:green)%(committerdate:relative)%(color:reset) | %(color:blue)%(authordate:short)%(color:reset)'

    selected=$( (git branch --sort=-committerdate --format="$fmt" --color=always | column -ts '|' | \
        fzf --ansi --no-multi --height 40% --query="$default_prefix" --tiebreak=index \
            --header 'Select a base branch name to copy/edit (Or press ESC to input manually)' \
            --bind 'start:deselect' \
            || true) | awk '{print ($1=="*" ? $2 : $1)}')

    base_name="${selected:-$default_prefix}"
fi

# 3. fzf を使った「編集・入力フォーム」
new_branch=$(echo "" | fzf --print-query \
    --query="$base_name" \
    --height 20% \
    --header 'Edit or type the new branch name (Press Enter to confirm, ESC to cancel)' \
    --bind 'enter:accept' \
    | head -n1)

# 4. Validation & Checkout
if [ -z "$new_branch" ] || [ "$new_branch" = "$default_prefix" ] || [[ "$new_branch" == *"_" ]]; then
    echo "Aborted. (Invalid or incomplete branch name)"
    exit 0
fi

git checkout -b "$new_branch"
